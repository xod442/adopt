# Copy to .env and adjust. All of these have sane defaults in docker-compose.yml;
# only set what you need to change.

# Subpath when served behind the edge, e.g. /adopt. Empty = root.
ADOPT_ROOT_PATH=

# Host port the container is published on (see docker-compose.yml).
ADOPT_PORT=9099

# Default Mist API host pre-filled on the dashboard form.
ADOPT_MIST_HOST=api.mist.com

# AOS-CX REST API version pyaoscx targets.
ADOPT_AOSCX_API_VERSION=10.09

# Field the AOS-CX system/mist resource expects the Mist registration code
# in — confirmed via the official HPE AOS-CX Fundamentals Guide. See
# app/cx_client.py.
ADOPT_MIST_REGISTRATION_FIELD=registration_code

# How many switches to push adoption codes to concurrently.
ADOPT_PUSH_CONCURRENCY=4

# Test-only escape hatches — leave unset in production.
ADOPT_MIST_BASE_URL_OVERRIDE=
ADOPT_CX_SCHEME=https
